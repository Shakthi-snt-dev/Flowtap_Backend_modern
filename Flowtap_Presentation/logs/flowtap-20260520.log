SELECT s."ProductId", s."ProductName", COALESCE(sum(s."Quantity"), 0.0)::int AS "QuantitySold", COALESCE(sum(s."Total"), 0.0) AS "Revenue"
FROM "SaleItems" AS s
INNER JOIN (
    SELECT s0."Id", s0."CompanyId", s0."CreatedAt", s0."LocationId"
    FROM "Sales" AS s0
